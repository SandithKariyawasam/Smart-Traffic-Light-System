<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[
globals [
  ;; UI variables will be used later
  pedestrian-queue
  pedestrian-state
  pedestrian-active-crosswalk
  pedestrian-timer
  south-exchanged?
  east-exchanged?
  north-exchanged?
  west-exchanged?
]

breed [ cars car ]
breed [ lights light ]
breed [ pedestrians pedestrian ]
breed [ visual-lights visual-light ]

visual-lights-own [ light-dir parent-light ]

lights-own [
  current-phase
  phase-timer
]

cars-own [
  speed
  max-speed
  current-road
  turn-intention ;; "straight", "left", "right"
  is-emergency?
]

patches-own [
  road?
  intersection?
  road-dir
]

to setup
  clear-all
  set pedestrian-queue []
  set pedestrian-state "IDLE"
  set pedestrian-active-crosswalk "NONE"
  set pedestrian-timer 0
  set south-exchanged? false
  set east-exchanged? false
  set north-exchanged? false
  set west-exchanged? false
  setup-environment
  reset-ticks
end

to setup-environment
  ask patches [
    set road? false
    set intersection? false
    set road-dir "NONE"
    set pcolor black
  ]
  
  ;; Vertical Road (North-South)
  ask patches with [pxcor >= -1 and pxcor <= 2] [
    set road? true
    set pcolor gray
    ifelse pxcor < 1 [ set road-dir "S" ] [ set road-dir "N" ]
  ]
  
  ;; Horizontal Road (East-West)
  ask patches with [pycor >= -1 and pycor <= 2] [
    set road? true
    set pcolor gray
    ifelse pycor > 0 [ set road-dir "W" ] [ set road-dir "E" ]
  ]
  
  ;; Intersection
  ask patches with [road? and (pxcor >= -1 and pxcor <= 2) and (pycor >= -1 and pycor <= 2)] [
    set intersection? true
    set road-dir "INTERSECTION"
  ]
  
  draw-road-lines
  
  create-lights 1 [
    set shape "circle"
    set size 0.1
    set hidden? true
    setxy 0.5 0.5
    set current-phase "N-green"
    set phase-timer 0
    
    let self-light self
    
    ;; Create visual light indicators at corners
    ;; North approach (cars going South) -> Southbound is x = 1, 2
    hatch-visual-lights 1 [ setxy 1 3 set shape "square" set size 1 set light-dir "S" set parent-light self-light set hidden? false ]
    hatch-visual-lights 1 [ setxy 2 3 set shape "square" set size 1 set light-dir "S" set parent-light self-light set hidden? false ]
    ;; South approach (cars going North) -> Northbound is x = -1, 0
    hatch-visual-lights 1 [ setxy -1 -2 set shape "square" set size 1 set light-dir "N" set parent-light self-light set hidden? false ]
    hatch-visual-lights 1 [ setxy 0 -2 set shape "square" set size 1 set light-dir "N" set parent-light self-light set hidden? false ]
    ;; East approach (cars going West) -> Westbound is y = -1, 0
    hatch-visual-lights 1 [ setxy 3 -1 set shape "square" set size 1 set light-dir "W" set parent-light self-light set hidden? false ]
    hatch-visual-lights 1 [ setxy 3 0 set shape "square" set size 1 set light-dir "W" set parent-light self-light set hidden? false ]
    ;; West approach (cars going East) -> Eastbound is y = 1, 2
    hatch-visual-lights 1 [ setxy -2 1 set shape "square" set size 1 set light-dir "E" set parent-light self-light set hidden? false ]
    hatch-visual-lights 1 [ setxy -2 2 set shape "square" set size 1 set light-dir "E" set parent-light self-light set hidden? false ]
    
    update-visuals
  ]
end

to draw-road-lines
  let x-segments (list (list min-pxcor -1.5) (list 2.5 max-pxcor))
  let y-segments (list (list min-pycor -1.5) (list 2.5 max-pycor))

  ;; Horizontal Roads (y = 0.5)
  foreach [0.5] [ y ->
    foreach x-segments [ seg ->
      let x1 item 0 seg
      let x2 item 1 seg
      draw-line x1 y x2 y yellow 2
      draw-dashed-line x1 (y + 1) x2 (y + 1) white 1 1
      draw-dashed-line x1 (y - 1) x2 (y - 1) white 1 1
    ]
  ]
  
  ;; Vertical Roads (x = 0.5)
  foreach [0.5] [ x ->
    foreach y-segments [ seg ->
      let y1 item 0 seg
      let y2 item 1 seg
      draw-line x y1 x y2 yellow 2
      draw-dashed-line (x + 1) y1 (x + 1) y2 white 1 1
      draw-dashed-line (x - 1) y1 (x - 1) y2 white 1 1
    ]
  ]
  
  ;; Draw stop lines
  let cx 0.5
  let cy 0.5
  ;; North approach (cars going South)
  draw-line cx (cy + 2) (cx + 2) (cy + 2) white 2
  draw-crosswalk (cx - 2) (cy + 2) (cx + 2) (cy + 3) "vertical-stripes"
  ;; South approach (cars going North)
  draw-line (cx - 2) (cy - 2) cx (cy - 2) white 2
  draw-crosswalk (cx - 2) (cy - 3) (cx + 2) (cy - 2) "vertical-stripes"
  ;; East approach (cars going West)
  draw-line (cx + 2) (cy - 2) (cx + 2) cy white 2
  draw-crosswalk (cx + 2) (cy - 2) (cx + 3) (cy + 2) "horizontal-stripes"
  ;; West approach (cars going East)
  draw-line (cx - 2) cy (cx - 2) (cy + 2) white 2
  draw-crosswalk (cx - 3) (cy - 2) (cx - 2) (cy + 2) "horizontal-stripes"
end

to draw-line [x1 y1 x2 y2 lcolor thick]
  create-turtles 1 [
    set hidden? true
    setxy x1 y1
    set heading atan (x2 - x1) (y2 - y1)
    set color lcolor
    set pen-size thick
    pen-down
    fd sqrt ((x2 - x1) ^ 2 + (y2 - y1) ^ 2)
    die
  ]
end

to draw-dashed-line [x1 y1 x2 y2 lcolor thick d-len]
  create-turtles 1 [
    set hidden? true
    setxy x1 y1
    set heading atan (x2 - x1) (y2 - y1)
    set color lcolor
    set pen-size thick
    let total-dist sqrt ((x2 - x1) ^ 2 + (y2 - y1) ^ 2)
    let travelled 0
    while [travelled < total-dist] [
      pen-down
      let move-dist min (list d-len (total-dist - travelled))
      fd move-dist
      set travelled travelled + move-dist
      pen-up
      if travelled < total-dist [
        set move-dist min (list d-len (total-dist - travelled))
        fd move-dist
        set travelled travelled + move-dist
      ]
    ]
    die
  ]
end

to draw-crosswalk [x1 y1 x2 y2 dir]
  if dir = "vertical-stripes" [
    let i x1
    while [i <= x2] [
      draw-line i y1 i y2 white 1
      set i i + 0.3
    ]
  ]
  if dir = "horizontal-stripes" [
    let i y1
    while [i <= y2] [
      draw-line x1 i x2 i white 1
      set i i + 0.3
    ]
  ]
end

to press-pedestrian-button
  if not member? "West" pedestrian-queue and pedestrian-active-crosswalk != "West" [
    set pedestrian-queue lput "West" pedestrian-queue
  ]
end

to press-pedestrian-button-south
  if not member? "South" pedestrian-queue and pedestrian-active-crosswalk != "South" [
    set pedestrian-queue lput "South" pedestrian-queue
  ]
end

to press-pedestrian-button-east
  if not member? "East" pedestrian-queue and pedestrian-active-crosswalk != "East" [
    set pedestrian-queue lput "East" pedestrian-queue
  ]
end

to press-pedestrian-button-north
  if not member? "North" pedestrian-queue and pedestrian-active-crosswalk != "North" [
    set pedestrian-queue lput "North" pedestrian-queue
  ]
end

to go
  ;; Pedestrian State Machine
  if pedestrian-state = "IDLE" [
    if length pedestrian-queue > 0 [
      set pedestrian-active-crosswalk item 0 pedestrian-queue
      set pedestrian-queue remove-item 0 pedestrian-queue
      set pedestrian-state "WAITING"
      set pedestrian-timer 40
    ]
  ]
  
  if pedestrian-state = "WAITING" [
    set pedestrian-timer pedestrian-timer - 1
    if pedestrian-timer <= 0 [
      set pedestrian-state "ACTIVE"
      if pedestrian-active-crosswalk = "West" [
        set south-exchanged? true
        ask lights [ set current-phase "pedestrian-west" set phase-timer 0 ]
      ]
      if pedestrian-active-crosswalk = "South" [
        set east-exchanged? true
        ask lights [ set current-phase "pedestrian-south" set phase-timer 0 ]
      ]
      if pedestrian-active-crosswalk = "East" [
        set north-exchanged? true
        ask lights [ set current-phase "pedestrian-east" set phase-timer 0 ]
      ]
      if pedestrian-active-crosswalk = "North" [
        set west-exchanged? true
        ask lights [ set current-phase "pedestrian-north" set phase-timer 0 ]
      ]
    ]
  ]
  
  if pedestrian-state = "ACTIVE" [
    let is-ped-phase? false
    ask lights [ if current-phase = "pedestrian-west" or current-phase = "pedestrian-south" or current-phase = "pedestrian-east" or current-phase = "pedestrian-north" [ set is-ped-phase? true ] ]
    if not is-ped-phase? [
      set pedestrian-state "BUFFER"
      set pedestrian-active-crosswalk "NONE"
      set pedestrian-timer 50
    ]
  ]
  
  if pedestrian-state = "BUFFER" [
    set pedestrian-timer pedestrian-timer - 1
    if pedestrian-timer <= 0 [
      set pedestrian-state "IDLE"
    ]
  ]

  ask lights [ update-lights ]
  spawn-vehicles
  ask cars [ perceive-and-move ]
  
  if [current-phase] of one-of lights = "pedestrian-west" and [phase-timer] of one-of lights < 50 [
    if random 100 < 30 [
      let p-spawn-y one-of [-1.5 2.5]
      let p-spawn-x (random-float 1.0) - 2.5
      create-pedestrians 1 [
        set shape "dot"
        set color black
        set size 0.5
        setxy p-spawn-x p-spawn-y
        ifelse p-spawn-y = -1.5 [ set heading 0 ] [ set heading 180 ]
      ]
    ]
  ]
  
  if [current-phase] of one-of lights = "pedestrian-south" and [phase-timer] of one-of lights < 50 [
    if random 100 < 30 [
      let p-spawn-x one-of [-1.5 2.5]
      let p-spawn-y (random-float 1.0) - 2.5
      create-pedestrians 1 [
        set shape "dot"
        set color black
        set size 0.5
        setxy p-spawn-x p-spawn-y
        ifelse p-spawn-x = -1.5 [ set heading 90 ] [ set heading 270 ]
      ]
    ]
  ]
  
  if [current-phase] of one-of lights = "pedestrian-east" and [phase-timer] of one-of lights < 50 [
    if random 100 < 30 [
      let p-spawn-y one-of [-1.5 2.5]
      let p-spawn-x (random-float 1.0) + 2.5
      create-pedestrians 1 [
        set shape "dot"
        set color black
        set size 0.5
        setxy p-spawn-x p-spawn-y
        ifelse p-spawn-y = -1.5 [ set heading 0 ] [ set heading 180 ]
      ]
    ]
  ]
  
  if [current-phase] of one-of lights = "pedestrian-north" and [phase-timer] of one-of lights < 50 [
    if random 100 < 30 [
      let p-spawn-x one-of [-1.5 2.5]
      let p-spawn-y (random-float 1.0) + 2.5
      create-pedestrians 1 [
        set shape "dot"
        set color black
        set size 0.5
        setxy p-spawn-x p-spawn-y
        ifelse p-spawn-x = -1.5 [ set heading 90 ] [ set heading 270 ]
      ]
    ]
  ]

  ask pedestrians [
    fd 0.1
    if (heading = 0 or heading = 180) and (ycor > 2.5 or ycor < -1.5) [ die ]
    if (heading = 90 or heading = 270) and (xcor > 2.5 or xcor < -1.5) [ die ]
  ]
  
  tick
end

to update-lights
  set phase-timer phase-timer + 1
  
  if current-phase = "pedestrian-west" [
    if phase-timer >= 100 [
      set current-phase "N-green"
      set phase-timer 0
      set south-exchanged? false
    ]
    update-visuals
    stop
  ]
  
  if current-phase = "pedestrian-south" [
    if phase-timer >= 100 [
      set current-phase "N-green"
      set phase-timer 0
      set east-exchanged? false
    ]
    update-visuals
    stop
  ]
  
  if current-phase = "pedestrian-east" [
    if phase-timer >= 100 [
      set current-phase "N-green"
      set phase-timer 0
      set north-exchanged? false
    ]
    update-visuals
    stop
  ]
  
  if current-phase = "pedestrian-north" [
    if phase-timer >= 100 [
      set current-phase "N-green"
      set phase-timer 0
      set west-exchanged? false
    ]
    update-visuals
    stop
  ]
  
  ;; Emergency vehicle override logic
  let emergency-dir "NONE"
  if emergency-vehicles? [
    let approaching-evs cars with [is-emergency? and (distancexy 0.5 0.5 < 15)]
    if any? approaching-evs [
      let closest-ev min-one-of approaching-evs [distancexy 0.5 0.5]
      let dir [current-road] of closest-ev
      let heading-towards? false
      if dir = "N" and [ycor] of closest-ev < 0 [ set heading-towards? true ]
      if dir = "S" and [ycor] of closest-ev > 1 [ set heading-towards? true ]
      if dir = "E" and [xcor] of closest-ev < 0 [ set heading-towards? true ]
      if dir = "W" and [xcor] of closest-ev > 1 [ set heading-towards? true ]
      
      if heading-towards? [
         set emergency-dir dir
      ]
    ]
  ]

  let cars-waiting-N count cars with [current-road = "N" and ycor < -2]
  let cars-waiting-S count cars with [current-road = "S" and ycor > 3]
  let cars-waiting-E count cars with [current-road = "E" and xcor < -2]
  let cars-waiting-W count cars with [current-road = "W" and xcor > 3]
  
  let current-waiting 0
  if current-phase = "N-green" [ set current-waiting cars-waiting-N ]
  if current-phase = "S-green" [ set current-waiting cars-waiting-S ]
  if current-phase = "E-green" [ set current-waiting cars-waiting-E ]
  if current-phase = "W-green" [ set current-waiting cars-waiting-W ]
  
  let total-others-waiting (cars-waiting-N + cars-waiting-S + cars-waiting-E + cars-waiting-W) - current-waiting
  
  let is-green-phase? (current-phase = "N-green" or current-phase = "S-green" or current-phase = "E-green" or current-phase = "W-green")
  
  ifelse is-green-phase? [
    let switch? false
    
    if emergency-dir != "NONE" [
      let ev-phase (word emergency-dir "-green")
      ifelse current-phase = ev-phase [
         set phase-timer 0 ;; hold green
      ] [
         set switch? true ;; force switch to let ev through
      ]
    ]
    
    if emergency-dir = "NONE" [
      if phase-timer >= 30 and current-waiting = 0 and total-others-waiting > 0 [
        set switch? true
      ]
      if phase-timer >= max-green and total-others-waiting > 0 [
        set switch? true
      ]
    ]
    
    if switch? [
      if current-phase = "N-green" [ set current-phase "N-yellow" ]
      if current-phase = "S-green" [ set current-phase "S-yellow" ]
      if current-phase = "E-green" [ set current-phase "E-yellow" ]
      if current-phase = "W-green" [ set current-phase "W-yellow" ]
      set phase-timer 0
    ]
  ] [
    ;; It's a yellow phase
    let intersection-clear? not any? cars with [[intersection?] of patch-here]
    
    ;; Wait for at least 7 ticks AND for the intersection to be clear. Force switch after 30 ticks just in case.
    if phase-timer >= 7 and (intersection-clear? or phase-timer > 30) [
      ifelse emergency-dir != "NONE" [
         set current-phase (word emergency-dir "-green")
      ] [
        let demand-N cars-waiting-N
        let demand-S cars-waiting-S
        let demand-E cars-waiting-E
        let demand-W cars-waiting-W
        
        if current-phase = "N-yellow" [ set demand-N -1 ]
        if current-phase = "S-yellow" [ set demand-S -1 ]
        if current-phase = "E-yellow" [ set demand-E -1 ]
        if current-phase = "W-yellow" [ set demand-W -1 ]
        
        let max-other max (list demand-N demand-S demand-E demand-W)
        
        ifelse max-other > 0 [
          let picked? false
          if max-other = demand-N and not picked? [ set current-phase "N-green" set picked? true ]
          if max-other = demand-S and not picked? [ set current-phase "S-green" set picked? true ]
          if max-other = demand-E and not picked? [ set current-phase "E-green" set picked? true ]
          if max-other = demand-W and not picked? [ set current-phase "W-green" set picked? true ]
        ] [
          let picked? false
          if current-phase = "N-yellow" and not picked? [ set current-phase "S-green" set picked? true ]
          if current-phase = "S-yellow" and not picked? [ set current-phase "E-green" set picked? true ]
          if current-phase = "E-yellow" and not picked? [ set current-phase "W-green" set picked? true ]
          if current-phase = "W-yellow" and not picked? [ set current-phase "N-green" set picked? true ]
        ]
      ]
      set phase-timer 0
    ]
  ]
  
  update-visuals
end

to update-visuals
  let phase current-phase
  ask visual-lights with [parent-light = myself] [
    set color red
    ;; Main Phase
    if light-dir = "N" [
      ifelse south-exchanged? [
        if xcor = 0 [ set color green ]
      ] [
        if phase = "N-green" [ set color green ]
        if phase = "N-yellow" [ set color yellow ]
      ]
    ]
    
    if light-dir = "S" [
      ifelse north-exchanged? [
        if xcor = 1 [ set color green ]
      ] [
        if phase = "S-green" [ set color green ]
        if phase = "S-yellow" [ set color yellow ]
      ]
    ]
    
    if light-dir = "E" [
      ifelse west-exchanged? [
        if ycor = 1 [ set color green ]
      ] [
        if phase = "E-green" [ set color green ]
        if phase = "E-yellow" [ set color yellow ]
      ]
    ]
    
    if light-dir = "W" [
      ifelse east-exchanged? [
        if ycor = 0 [ set color green ]
      ] [
        if phase = "W-green" [ set color green ]
        if phase = "W-yellow" [ set color yellow ]
      ]
    ]
    
    ;; Continuous Flow Left-Turn Lanes (Always Green)
    ;; Since left turns use dedicated outer lanes and never cross or merge with any other traffic,
    ;; they can be permanently green!
    if light-dir = "N" and xcor = -1 [ 
      ifelse (south-exchanged? or phase = "pedestrian-south") [ set color red ] [ set color green ]
    ]
    if light-dir = "S" and xcor = 2 [ 
      ifelse (north-exchanged? or phase = "pedestrian-north") [ set color red ] [ set color green ]
    ]
    if light-dir = "E" and ycor = 2 [ 
      ifelse (west-exchanged? or phase = "pedestrian-west") [ set color red ] [ set color green ]
    ]
    if light-dir = "W" and ycor = -1 [ 
      ifelse (east-exchanged? or phase = "pedestrian-east") [ set color red ] [ set color green ]
    ]
  ]
end

to spawn-vehicles
  let spawn-dirs ["N" "S" "E" "W"]
  
  foreach spawn-dirs [ dir ->
    if random 100 < traffic-density [
      let intention one-of ["straight" "left" "right"]
      let spawn-x 0
      let spawn-y 0
      
      if dir = "N" [
        set spawn-y min-pycor
        ifelse intention = "left" [ set spawn-x -1 ] [ set spawn-x 0 ]
      ]
      if dir = "S" [
        set spawn-y max-pycor
        ifelse intention = "left" [ set spawn-x 2 ] [ set spawn-x 1 ]
      ]
      if dir = "E" [
        set spawn-x min-pxcor
        ifelse intention = "left" [ set spawn-y 2 ] [ set spawn-y 1 ]
      ]
      if dir = "W" [
        set spawn-x max-pxcor
        ifelse intention = "left" [ set spawn-y -1 ] [ set spawn-y 0 ]
      ]
      
      let spawn-patch patch spawn-x spawn-y
      if spawn-patch != nobody and not any? cars-on spawn-patch [
        ask spawn-patch [
          sprout-cars 1 [
            set shape "car"
            set size 1.5
            set speed 0.5
            set max-speed 1.0
            set current-road dir
            set turn-intention intention
            set is-emergency? false
            set color one-of [blue brown]
            
            if emergency-vehicles? and random 100 < 2 [
              set is-emergency? true
              set color white
              set max-speed 1.5
            ]
            
            if current-road = "E" [ set heading 90 ]
            if current-road = "W" [ set heading 270 ]
            if current-road = "N" [ set heading 0 ]
            if current-road = "S" [ set heading 180 ]
          ]
        ]
      ]
    ]
  ]
end

to perceive-and-move
  ;; 1. Obey Traffic Light
  let entering? false
  if current-road = "N" and ycor < -2 [ set entering? true ]
  if current-road = "S" and ycor > 3 [ set entering? true ]
  if current-road = "E" and xcor < -2 [ set entering? true ]
  if current-road = "W" and xcor > 3 [ set entering? true ]
  
  if entering? and patch-ahead 2 != nobody and [intersection?] of (patch-ahead 2) [
    let my-light one-of lights
    if my-light != nobody [
      let phase [current-phase] of my-light
      
      let green-light? false
      if current-road = "N" [
        ifelse south-exchanged? [
          if xcor = 0 [ set green-light? true ]
        ] [
          if (phase = "N-green" or (xcor = -1 and phase != "pedestrian-south")) [ set green-light? true ]
        ]
      ]
      if current-road = "S" [
        ifelse north-exchanged? [
          if xcor = 1 [ set green-light? true ]
        ] [
          if (phase = "S-green" or (xcor = 2 and phase != "pedestrian-north")) [ set green-light? true ]
        ]
      ]
      if current-road = "E" [
        ifelse west-exchanged? [
          if ycor = 1 [ set green-light? true ]
        ] [
          if (phase = "E-green" or (ycor = 2 and phase != "pedestrian-west")) [ set green-light? true ]
        ]
      ]
      if current-road = "W" [
        ifelse east-exchanged? [
          if ycor = 0 [ set green-light? true ]
        ] [
          if (phase = "W-green" or (ycor = -1 and phase != "pedestrian-east")) [ set green-light? true ]
        ]
      ]
      
      if not green-light? [
        set speed 0 stop
      ]
    ]
  ]
  
  ;; 2. Intersection Turning Logic
  if [intersection?] of patch-here [
    let p patch-here
    
    if current-road = "S" [
      if turn-intention = "left" and [pycor] of p = 2 [ set current-road "E" set heading 90 set ycor 2 set turn-intention "straight" ]
      if turn-intention = "right" and [pycor] of p = 0 [ set current-road "W" set heading 270 set ycor 0 set turn-intention "straight" ]
    ]
    if current-road = "N" [
      if turn-intention = "left" and [pycor] of p = -1 [ set current-road "W" set heading 270 set ycor -1 set turn-intention "straight" ]
      if turn-intention = "right" and [pycor] of p = 1 [ set current-road "E" set heading 90 set ycor 1 set turn-intention "straight" ]
    ]
    if current-road = "E" [
      if turn-intention = "left" and [pxcor] of p = -1 [ set current-road "N" set heading 0 set xcor -1 set turn-intention "straight" ]
      if turn-intention = "right" and [pxcor] of p = 1 [ set current-road "S" set heading 180 set xcor 1 set turn-intention "straight" ]
    ]
    if current-road = "W" [
      if turn-intention = "left" and [pxcor] of p = 2 [ set current-road "S" set heading 180 set xcor 2 set turn-intention "straight" ]
      if turn-intention = "right" and [pxcor] of p = 0 [ set current-road "N" set heading 0 set xcor 0 set turn-intention "straight" ]
    ]
  ]
  
  ;; 3. Determine target patch & Collision Avoidance
  let target-patch patch-ahead 1
  if target-patch != nobody [
    if any? cars-on target-patch [
      set speed 0
      stop
    ]
  ]
  
  ;; 4. Accelerate and Move
  if speed < max-speed [ set speed speed + 0.2 ]
  fd speed
  
  ;; 5. Remove cars at boundary
  if (current-road = "N" and ycor >= max-pycor - 1) [ die ]
  if (current-road = "S" and ycor <= min-pycor + 1) [ die ]
  if (current-road = "E" and xcor >= max-pxcor - 1) [ die ]
  if (current-road = "W" and xcor <= min-pxcor + 1) [ die ]
end
]]></code>
  <widgets>
    <view x="310" wrappingAllowedX="true" y="15" frameRate="30.0" minPycor="-17" height="714" showTickCounter="true" patchSize="20.0" fontSize="10" wrappingAllowedY="true" width="714" tickCounterLabel="ticks" maxPycor="17" updateMode="0" maxPxcor="17" minPxcor="-17"></view>
