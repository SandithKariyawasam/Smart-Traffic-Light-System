<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[;; ============================================================================
;; SMART ADAPTIVE TRAFFIC LIGHT CONTROL SYSTEM (SATLCS)
;; Group Assignment - Agent-Based Systems (SE404.3)
;; ============================================================================

;; --- GLOBAL VARIABLES ---
globals [
  average-waiting-time   ;; Performance measure: Avg ticks vehicles spend stopped
  total-throughput       ;; Performance measure: Total cars that exited the network
  total-waiting-time     ;; Cumulative waiting time of all vehicles
  completed-trips        ;; Count of vehicles that successfully reached an exit
]

;; --- BREED DEFINITIONS & ATTRIBUTES ---
;; Section 4.1 & 4.2 of Report: Agent Identification
breed [ lights light ]
breed [ cars car ]
breed [ emergencies emergency ]
breed [ visual-lights visual-light ]

visual-lights-own [ light-type light-dir parent-light ]

;; Traffic-Light Agent Attributes
lights-own [
  current-phase          ;; "NS-green", "EW-green", or "Pedestrian-walk"
  phase-timer            ;; Elapsed ticks in the current phase (FSM state tracking)
  queue-ns               ;; Sensed count of vehicles waiting North-South
  queue-ew               ;; Sensed count of vehicles waiting East-West
  neighbour-congestion   ;; Broadcasted congestion level from adjacent intersections
  emergency-detected?    ;; Boolean flag: True if siren detected within radius
]

;; Vehicle (Car) Agent Attributes
cars-own [
  speed                  ;; Current speed (patches per tick)
  max-speed              ;; Top speed allowed
  waiting-time           ;; Ticks spent stopped (speed = 0)
  stopped?               ;; Boolean flag: True if waiting at a light or traffic
  current-road           ;; Direction of current road ("N", "S", "E", "W")
  destination            ;; Target exit boundary
  patience               ;; Ticks before attempting to reroute around congestion
]

;; Emergency Vehicle Attributes
emergencies-own [
  speed                  ;; Current speed (higher max-speed than cars)
  siren-active?          ;; Boolean flag: Alerts traffic lights and cars
  waiting-time           ;; Tracked to ensure near-zero delay goal
]

;; Environment Patch Attributes (Section 5.1 of Report)
patches-own [
  road?                  ;; True if patch is drivable
  intersection?          ;; True if patch is a signalised junction
  crossing?              ;; True if patch is a pedestrian crossing
  road-dir               ;; Direction of traffic: "N", "S", "E", "W", or "NONE"
  congestion-level       ;; Sensed vehicle count on this road segment
]

;; ============================================================================
;; 1. SETUP PROCEDURES (Member 1 & Member 2)
;; ============================================================================

to setup
  clear-all
  reset-ticks
  
  ;; Initialize global performance measures
  set total-waiting-time 0
  set completed-trips 0
  set average-waiting-time 0
  set total-throughput 0
  
  ;; Setup environment structure
  setup-environment
  
  ;; Place Traffic Light agents at intersections
  setup-traffic-lights
  
  ;; Initial population of vehicles and pedestrians
  spawn-vehicles
  
  reset-ticks
end

to setup-environment
  ;; Set default background to building/non-road (Black)
  ask patches [
    set road? false
    set intersection? false
    set crossing? false
    set road-dir "NONE"
    set pcolor black
    set congestion-level 0
  ]
  
  ;; Create a single central cross intersection (Grey patches)
  ;; Horizontal road (East-West)
  ask patches with [ pycor >= -1 and pycor <= 2 ] [
    set road? true
    set pcolor gray
    ifelse (pycor >= 1) [ set road-dir "E" ] [ set road-dir "W" ]
  ]
  
  ;; Vertical road (North-South)
  ask patches with [ pxcor >= -1 and pxcor <= 2 ] [
    set road? true
    set pcolor gray
    ifelse (pxcor <= 0) [ set road-dir "N" ] [ set road-dir "S" ]
  ]
  
  ;; Mark Intersections (where horizontal and vertical roads cross)
  ask patches with [ road? and (pxcor >= -1 and pxcor <= 2) 
                           and (pycor >= -1 and pycor <= 2) ] [
    set intersection? true
    set road-dir "INTERSECTION"
    set pcolor gray
  ]
  
  ;; Mark Pedestrian Crossings adjacent to intersections
  ask patches with [ road? and not intersection? and 
                     (any? neighbors with [intersection?]) ] [
    set crossing? true
    set pcolor gray
  ]
  
  ;; Draw advanced UI (lane markings, stop lines, zebra crossings)
  draw-advanced-ui
end

to setup-traffic-lights
  ;; Create 1 traffic light agent at the center of the main intersection
  foreach [ [0.5 0.5] ] [ coords ->
    create-lights 1 [
      setxy item 0 coords item 1 coords
      set hidden? true
      set current-phase "NS-green"
      set phase-timer 0
      set queue-ns 0
      set queue-ew 0
      set neighbour-congestion 0
      set emergency-detected? false
      
      let self-light self
      let cx item 0 coords
      let cy item 1 coords
      
      ;; North approach (S bound)
      hatch-visual-lights 1 [ setxy (cx + 0.5) (cy + 3.5) set shape "square" set size 1 set light-type "vehicle" set light-dir "S" set hidden? false set parent-light self-light ]
      hatch-visual-lights 1 [ setxy (cx + 1.5) (cy + 3.5) set shape "square" set size 1 set light-type "vehicle" set light-dir "S" set hidden? false set parent-light self-light ]
      
      ;; South approach (N bound)
      hatch-visual-lights 1 [ setxy (cx - 0.5) (cy - 3.5) set shape "square" set size 1 set light-type "vehicle" set light-dir "N" set hidden? false set parent-light self-light ]
      hatch-visual-lights 1 [ setxy (cx - 1.5) (cy - 3.5) set shape "square" set size 1 set light-type "vehicle" set light-dir "N" set hidden? false set parent-light self-light ]
      
      ;; East approach (W bound)
      hatch-visual-lights 1 [ setxy (cx + 3.5) (cy - 0.5) set shape "square" set size 1 set light-type "vehicle" set light-dir "W" set hidden? false set parent-light self-light ]
      hatch-visual-lights 1 [ setxy (cx + 3.5) (cy - 1.5) set shape "square" set size 1 set light-type "vehicle" set light-dir "W" set hidden? false set parent-light self-light ]
      
      ;; West approach (E bound)
      hatch-visual-lights 1 [ setxy (cx - 3.5) (cy + 0.5) set shape "square" set size 1 set light-type "vehicle" set light-dir "E" set hidden? false set parent-light self-light ]
      hatch-visual-lights 1 [ setxy (cx - 3.5) (cy + 1.5) set shape "square" set size 1 set light-type "vehicle" set light-dir "E" set hidden? false set parent-light self-light ]
      
      update-signal-visuals
    ]
  ]
end

;; ============================================================================
;; 2. MAIN SIMULATION LOOP (THE GO PROCEDURE)
;; ============================================================================

to go
  ;; 1. Spawn new agents stochastically at boundaries
  if random 100 < traffic-density [ spawn-vehicles ]
  if emergency-vehicles? and random 500 < 5 [ spawn-emergency ]
  
  ;; 2. Agent-Environment Loop: Traffic Lights (Primary Agent)
  ask lights [
    perceive-environment   ;; Step 1: Sense queues and sirens
    decide-light-action    ;; Step 2 & 3: Evaluate rules and act (Hybrid Arch)
    update-signal-visuals  ;; Step 4: Alter environment state (patch colors)
  ]
  
  ;; 3. Agent-Environment Loop: Emergency Vehicles (Priority Movement)
  ask emergencies [
    move-emergency
  ]
  
  ;; 4. Agent-Environment Loop: Normal Vehicles
  ask cars [
    perceive-and-move
    check-exit
  ]
  
  ;; 5. Update data collection and system measures
  update-metrics
  
  tick
end

;; ============================================================================
;; 3. TRAFFIC LIGHT AGENT LOGIC (HYBRID ARCHITECTURE)
;; Section 6.1 & 8.1 of Report: Member 2
;; ============================================================================

to perceive-environment
  ;; SENSORS: Count vehicles stopped within detection radius (e.g., 8 patches)
  set queue-ns count cars in-radius 8 with [ (current-road = "N" or current-road = "S") and stopped? ]
  set queue-ew count cars in-radius 8 with [ (current-road = "E" or current-road = "W") and stopped? ]
  
  ;; Sensor: Check for emergency siren within detection radius
  set emergency-detected? any? emergencies in-radius 10
  
  ;; Sensor: Read neighbour congestion (for Coordinated mode)
  if control-mode = "Coordinated" [
    let my-neighbours other lights in-radius 25
    if any? my-neighbours [
      set neighbour-congestion mean [queue-ns + queue-ew] of my-neighbours
    ]
  ]
end

to decide-light-action
  set phase-timer phase-timer + 1
  
  ;; --- CONTROL LAYER: FIXED MODE ---
  if control-mode = "Fixed" [
    if phase-timer >= max-green [ switch-phase ]
    stop
  ]
  
  ;; --- HYBRID ARCHITECTURE (ADAPTIVE & COORDINATED MODES) ---
  ;; Priority 1: REACTIVE LAYER - Emergency Pre-emption
  if emergency-detected? [
    let approaching-em one-of emergencies in-radius 10
    if approaching-em != nobody [
      ;; Force green in the direction of the emergency vehicle
      let em-dir [current-road] of approaching-em
      if (em-dir = "N" or em-dir = "S") and current-phase != "NS-green" [ switch-to "NS-green" ]
      if (em-dir = "E" or em-dir = "W") and current-phase != "EW-green" [ switch-to "EW-green" ]
      stop
    ]
  ]
  
  ;; Priority 2: REACTIVE LAYER - Minimum Green Safety Constraint
  if phase-timer < min-green [
    stop ;; Hold phase, no switching allowed
  ]
  
  ;; Priority 3: REACTIVE LAYER - Maximum Green Starvation Prevention
  if phase-timer >= max-green [
    switch-phase
    stop
  ]
  
  ;; Priority 5: DELIBERATIVE LAYER - Queue Optimization Rule
  ;; Switch if the red approach queue exceeds green approach by switching-threshold
  if current-phase = "NS-green" and (queue-ew > (queue-ns + switching-threshold)) [
    ;; In Coordinated mode, verify downstream EW is not heavily congested (Priority 6)
    if not (control-mode = "Coordinated" and neighbour-congestion > 10) [
      switch-phase
      stop
    ]
  ]
  
  if current-phase = "EW-green" and (queue-ns > (queue-ew + switching-threshold)) [
    if not (control-mode = "Coordinated" and neighbour-congestion > 10) [
      switch-phase
      stop
    ]
  ]
  
  ;; Priority 7: Default Action - Extend current green phase
  ;; (phase-timer already incremented at start of procedure)
end

to switch-phase
  ;; Finite State Machine (FSM) Transitions
  if current-phase = "NS-green" [
    set current-phase "EW-green"
    set phase-timer 0
    stop
  ]
  if current-phase = "EW-green" [
    set current-phase "NS-green"
    set phase-timer 0
    stop
  ]
end

to switch-to [ new-phase ]
  set current-phase new-phase
  set phase-timer 0
end

to update-signal-visuals
  let phase current-phase
  ask visual-lights with [ parent-light = myself ] [
    if (light-type = "vehicle") [
      if (light-dir = "N" or light-dir = "S") [
        ifelse phase = "NS-green" [ set color green ] [ set color red ]
      ]
      if (light-dir = "E" or light-dir = "W") [
        ifelse phase = "EW-green" [ set color green ] [ set color red ]
      ]
    ]
  ]
end

;; ============================================================================
;; 4. VEHICLE MOVEMENT & INTERACTION RULES
;; Section 6.2 of Report: Member 3
;; ============================================================================

to perceive-and-move
  ;; Yield to pedestrians on crosswalk
  let target-patch nobody
  if current-road = "N" [ set target-patch patch-at 0 1 ]
  if current-road = "S" [ set target-patch patch-at 0 -1 ]
  if current-road = "E" [ set target-patch patch-at 1 0 ]
  if current-road = "W" [ set target-patch patch-at -1 0 ]
  
  if target-patch != nobody [
    ;; Rule 2: Stop for vehicles ahead (Collision avoidance)
    if any? cars-on target-patch or any? emergencies-on target-patch [
      set speed 0
      set stopped? true
      stop
    ]
  ]

  ;; Rule: Obey Traffic Signals (Control obstacles)
  ;; Only obey the light if entering the intersection (not inside or leaving it)
  let entering? false
  if current-road = "N" and ycor < -1 [ set entering? true ]
  if current-road = "S" and ycor > 2 [ set entering? true ]
  if current-road = "E" and xcor < -1 [ set entering? true ]
  if current-road = "W" and xcor > 2 [ set entering? true ]
  
  if entering? and target-patch != nobody and ([intersection?] of target-patch or [crossing?] of target-patch) [
    let light-ahead one-of lights in-radius 5
    if light-ahead != nobody [
      let phase [current-phase] of light-ahead
      ;; Stop if light is red for my direction
      if (current-road = "N" or current-road = "S") and phase != "NS-green" [
        set speed 0
        set stopped? true
        set waiting-time waiting-time + 1
        stop
      ]
      if (current-road = "E" or current-road = "W") and phase != "EW-green" [
        set speed 0
        set stopped? true
        set waiting-time waiting-time + 1
        stop
      ]
    ]
  ]
  
  ;; Rule 3: Yield to Emergency Vehicles (Interaction rule)
  if any? emergencies in-radius 3 [
    set speed 0
    set stopped? true
    stop
  ]
  
  ;; Rule 4: Accelerate and Move (Road clear)
  set stopped? false
  if speed < max-speed [ set speed speed + 0.2 ]
  
  if current-road = "N" [ set ycor ycor + speed ]
  if current-road = "S" [ set ycor ycor - speed ]
  if current-road = "E" [ set xcor xcor + speed ]
  if current-road = "W" [ set xcor xcor - speed ]
  
  ;; Update road direction attribute based on patch
  if patch-here != nobody and [road-dir] of patch-here != "INTERSECTION" [
    set current-road [road-dir] of patch-here
  ]
end

to move-emergency
  ;; Emergency vehicles ignore red lights (Pre-emption assumed granted) but avoid collisions
  let target-patch nobody
  if road-dir = "N" [ set target-patch patch-at 0 1 ]
  if road-dir = "S" [ set target-patch patch-at 0 -1 ]
  if road-dir = "E" [ set target-patch patch-at 1 0 ]
  if road-dir = "W" [ set target-patch patch-at -1 0 ]
  
  if target-patch != nobody and not any? cars-on target-patch [
    if road-dir = "N" [ set ycor ycor + speed ]
    if road-dir = "S" [ set ycor ycor - speed ]
    if road-dir = "E" [ set xcor xcor + speed ]
    if road-dir = "W" [ set xcor xcor - speed ]
  ]
  
  if patch-here != nobody and [road-dir] of patch-here != "INTERSECTION" [
    set road-dir [road-dir] of patch-here
  ]
  
  if patch-here = nobody or not [road?] of patch-here [ die ]
end

to check-exit
  ;; Remove vehicle when it reaches world boundary (Sink) on its way OUT
  if (current-road = "E" and xcor >= max-pxcor - 1) or
     (current-road = "W" and xcor <= min-pxcor + 1) or
     (current-road = "N" and ycor >= max-pycor - 1) or
     (current-road = "S" and ycor <= min-pycor + 1) [
    ;; Data collection: record successful trip and waiting time
    set completed-trips completed-trips + 1
    set total-waiting-time total-waiting-time + waiting-time
    die
  ]
end

;; ============================================================================


to spawn-vehicles
  ;; Inject vehicles at boundary road patches (Sources)
  let entry-patches patches with [ road? and not any? cars-on self and
                                   ((pxcor = max-pxcor and road-dir = "W") or
                                    (pxcor = min-pxcor and road-dir = "E") or
                                    (pycor = max-pycor and road-dir = "S") or
                                    (pycor = min-pycor and road-dir = "N")) ]
  if any? entry-patches [
    ask one-of entry-patches [
      sprout-cars 1 [
        let vehicle-type random 3
        if vehicle-type = 0 [ set shape "car" set color one-of [blue red green yellow white black] set size 1.5 ]
        if vehicle-type = 1 [ set shape "truck" set color one-of [gray brown white] set size 2.0 ]
        if vehicle-type = 2 [ set shape "bug" set color one-of [red blue orange pink] set size 1.2 ]
        
        set speed 0.5
        set max-speed 1.0
        set waiting-time 0
        set stopped? false
        set current-road road-dir
        set patience 50
        ;; Face the correct visual driving direction
        if current-road = "E" [ set heading 90 ]
        if current-road = "W" [ set heading 270 ]
        if current-road = "N" [ set heading 0 ]
        if current-road = "S" [ set heading 180 ]
      ]
    ]
  ]
end

to spawn-emergency
  let entry-patches patches with [ road? and
                                   ((pxcor = max-pxcor and road-dir = "W") or
                                    (pxcor = min-pxcor and road-dir = "E") or
                                    (pycor = max-pycor and road-dir = "S") or
                                    (pycor = min-pycor and road-dir = "N")) ]
  if any? entry-patches [
    ask one-of entry-patches [
      sprout-emergencies 1 [
        set shape "truck"
        set color red
        set size 2
        set speed 1.5
        set siren-active? true
        set waiting-time 0
        if road-dir = "E" [ set heading 90 ]
        if road-dir = "W" [ set heading 270 ]
        if road-dir = "N" [ set heading 0 ]
        if road-dir = "S" [ set heading 180 ]
      ]
    ]
  ]
end

;; ============================================================================
;; 6. DATA COLLECTION & ANALYSIS (Member 5)
;; ============================================================================

to update-metrics
  ;; Calculate System Performance Measures (Section 7.1 of Report)
  
  ;; Average waiting time per vehicle across active and exited vehicles
  let active-wait sum [waiting-time] of cars
  let total-tracked-cars (count cars + completed-trips)
  
  ifelse total-tracked-cars > 0 [
    set average-waiting-time (total-waiting-time + active-wait) / total-tracked-cars
  ] [
    set average-waiting-time 0
  ]
  
  ;; Throughput: Rate of completed trips per 100 ticks
  ifelse ticks > 0 [
    set total-throughput (completed-trips / ticks) * 100
  ] [
    set total-throughput 0
  ]
  
  ;; Update patch congestion levels dynamically for visualization/coordination
  ask patches with [road?] [
    set congestion-level count cars in-radius 3
  ]
end

;; ============================================================================
;; UI DRAWING HELPERS
;; ============================================================================

to draw-advanced-ui
  let x-segments (list (list min-pxcor -1.5) (list 2.5 max-pxcor))
  let y-segments (list (list min-pycor -1.5) (list 2.5 max-pycor))

  ;; Horizontal Roads (y = 0.5)
  foreach [0.5] [ y ->
    foreach x-segments [ seg ->
      let x1 item 0 seg
      let x2 item 1 seg
      ;; Solid dividing line
      draw-line x1 y x2 y white 2
      ;; Dashed lane dividers
      draw-dashed-line x1 (y + 1) x2 (y + 1) white 1 1
      draw-dashed-line x1 (y - 1) x2 (y - 1) white 1 1
    ]
  ]
  
  ;; Vertical Roads (x = 0.5)
  foreach [0.5] [ x ->
    foreach y-segments [ seg ->
      let y1 item 0 seg
      let y2 item 1 seg
      ;; Solid dividing line
      draw-line x y1 x y2 white 2
      ;; Dashed lane dividers
      draw-dashed-line (x + 1) y1 (x + 1) y2 white 1 1
      draw-dashed-line (x - 1) y1 (x - 1) y2 white 1 1
    ]
  ]
  ;; Draw stop lines and zebra crossings for the main intersection
  foreach [ [0.5 0.5] ] [ coords ->
    let cx item 0 coords
    let cy item 1 coords
    
    ;; Stop lines ONLY for incoming lanes!
    ;; North approach (cars going South)
    draw-line cx (cy + 3) (cx + 2) (cy + 3) white 2
    ;; South approach (cars going North)
    draw-line (cx - 2) (cy - 3) cx (cy - 3) white 2
    ;; East approach (cars going West)
    draw-line (cx + 3) (cy - 2) (cx + 3) cy white 2
    ;; West approach (cars going East)
    draw-line (cx - 3) cy (cx - 3) (cy + 2) white 2
    
    ;; Zebra crossings
    draw-zebra (cx - 2) (cy + 2) (cx + 2) (cy + 3) true  ;; Top
    draw-zebra (cx - 2) (cy - 3) (cx + 2) (cy - 2) true  ;; Bottom
    draw-zebra (cx + 2) (cy - 2) (cx + 3) (cy + 2) false ;; Right
    draw-zebra (cx - 3) (cy - 2) (cx - 2) (cy + 2) false ;; Left
  ]
end

to draw-line [x1 y1 x2 y2 lcolor thick]
  create-turtles 1 [
    set hidden? true
    setxy x1 y1
    set heading atan (x2 - x1) (y2 - y1)
    set color lcolor
    set pen-size thick
    pen-down
    fd sqrt ((x2 - x1) ^ 2 + (y2 - y1) ^ 2)
    die
  ]
end

to draw-dashed-line [x1 y1 x2 y2 lcolor thick d-len]
  create-turtles 1 [
    set hidden? true
    setxy x1 y1
    set heading atan (x2 - x1) (y2 - y1)
    set color lcolor
    set pen-size thick
    let total-dist sqrt ((x2 - x1) ^ 2 + (y2 - y1) ^ 2)
    let travelled 0
    while [travelled < total-dist] [
      pen-down
      let move-dist min (list d-len (total-dist - travelled))
      fd move-dist
      set travelled travelled + move-dist
      pen-up
      if travelled < total-dist [
        set move-dist min (list d-len (total-dist - travelled))
        fd move-dist
        set travelled travelled + move-dist
      ]
    ]
    die
  ]
end

to draw-zebra [x1 y1 x2 y2 is-horizontal]
  if is-horizontal [
    let x min (list x1 x2) + 0.25
    while [x <= max (list x1 x2)] [
      draw-line x y1 x y2 white 2
      set x x + 0.5
    ]
  ]
  if not is-horizontal [
    let y min (list y1 y2) + 0.25
    while [y <= max (list y1 y2)] [
      draw-line x1 y x2 y white 2
      set y y + 0.5
    ]
  ]
end]]></code>
  <widgets>
    <view x="368" wrappingAllowedX="true" y="10" frameRate="30.0" minPycor="-17" height="714" showTickCounter="true" patchSize="20.0" fontSize="10" wrappingAllowedY="true" width="714" tickCounterLabel="ticks" maxPycor="17" updateMode="0" maxPxcor="17" minPxcor="-17"></view>
    <button x="40" y="45" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="55">setup</button>
    <button x="105" y="45" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="55">go</button>
    <slider x="40" step="1" y="95" max="20" width="250" display="traffic-density" height="50" min="1" direction="Horizontal" default="5.0" variable="traffic-density"></slider>
    <slider x="40" step="1" y="150" max="30" width="250" display="min-green" height="50" min="5" direction="Horizontal" default="10.0" variable="min-green"></slider>
    <slider x="40" step="1" y="205" max="120" width="250" display="max-green" height="50" min="30" direction="Horizontal" default="60.0" variable="max-green"></slider>
    <slider x="40" step="1" y="260" max="10" width="250" display="switching-threshold" height="50" min="1" direction="Horizontal" default="3.0" variable="switching-threshold"></slider>
    <chooser x="40" y="340" height="60" variable="control-mode" current="0" width="250" display="control-mode">
      <choice type="string" value="Fixed"></choice>
      <choice type="string" value="Adaptive"></choice>
      <choice type="string" value="Coordinated"></choice>
    </chooser>
    <switch x="40" y="425" height="40" on="true" variable="emergency-vehicles?" width="145" display="emergency-vehicles?"></switch>
    <monitor x="40" precision="17" y="490" height="60" fontSize="11" width="100">average-waiting-time</monitor>
    <monitor x="145" precision="17" y="490" height="60" fontSize="11" width="100">total-throughput</monitor>
  </widgets>
  <info>## WHAT IS IT?

(a general understanding of what the model is trying to show or explain)

## HOW IT WORKS

(what rules the agents use to create the overall behavior of the model)

## HOW TO USE IT

(how to use the model, including a description of each of the items in the Interface tab)

## THINGS TO NOTICE

(suggested things for the user to notice while running the model)

## THINGS TO TRY

(suggested things for the user to try to do (move sliders, switches, etc.) with the model)

## EXTENDING THE MODEL

(suggested things to add or change in the Code tab to make the model more complicated, detailed, accurate, etc.)

## NETLOGO FEATURES

(interesting or unusual features of NetLogo that the model uses, particularly in the Code tab; or where workarounds were needed for missing features)

## RELATED MODELS

(models in the NetLogo Models Library and elsewhere which are of related interest)

## CREDITS AND REFERENCES

(a reference to the model's URL on the web if it has one, as well as any other necessary credits, citations, and links)
</info>
  <turtleShapes>
    <shape name="default" rotatable="true" editableColorIndex="0">
      <polygon color="-1920102913" filled="true" marked="true">
        <point x="150" y="5"></point>
        <point x="40" y="250"></point>
        <point x="150" y="205"></point>
        <point x="260" y="250"></point>
      </polygon>
    </shape>
    <shape name="airplane" rotatable="true" editableColorIndex="0">
      <polygon color="-1920102913" filled="true" marked="true">
        <point x="150" y="0"></point>
        <point x="135" y="15"></point>
        <point x="120" y="60"></point>
